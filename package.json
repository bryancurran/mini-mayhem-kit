{
  "name": "mini-mayhem-kit",
  "version": "4.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Make minigames for Mini Mosh, the browser party game: templates, examples, a local playground, checks and uploads",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "update": "node tools/mm.mjs update",
    "new": "node tools/mm.mjs new",
    "check": "node tools/mm.mjs check",
    "play": "node tools/mm.mjs play",
    "shot": "node tools/mm.mjs shot",
    "pack": "node tools/mm.mjs pack",
    "login": "node tools/mm.mjs login",
    "logout": "node tools/mm.mjs logout",
    "upload": "node tools/mm.mjs upload",
    "delete": "node tools/mm.mjs delete",
    "get": "node tools/mm.mjs get",
    "list": "node tools/mm.mjs list",
    "setup-browser": "playwright-core install --only-shell chromium"
  },
  "dependencies": {
    "@jitl/quickjs-wasmfile-release-sync": "0.31.0",
    "playwright-core": "1.59.1",
    "quickjs-emscripten-core": "0.31.0",
    "three": "^0.186.1",
    "vite": "^8.3.4"
  }
}
